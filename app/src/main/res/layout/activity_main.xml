<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_console_screen">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_header_console"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnHistory"
                    android:layout_width="54dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_button_metal"
                    android:drawableTop="@drawable/ic_history"
                    android:drawablePadding="1dp"
                    android:drawableTint="@color/primary_light"
                    android:gravity="center"
                    android:text="@string/history_button"
                    android:textColor="@color/primary_light"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnDiceTheme"
                    android:layout_width="54dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_button_metal"
                    android:drawableTop="@drawable/ic_skin"
                    android:drawablePadding="1dp"
                    android:drawableTint="@color/primary_light"
                    android:gravity="center"
                    android:text="@string/dice_theme_button"
                    android:textColor="@color/primary_light"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/teko_variable"
                    android:letterSpacing="0.14"
                    android:text="@string/console_title"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="112dp"
                    android:layout_height="17dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/header_winged_skull" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/statusLamp"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:background="@drawable/lamp_dim" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="monospace"
                    android:text="@string/status_loading"
                    android:textColor="@color/success_light"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/diceStage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dice_stage"
            android:minHeight="220dp"
            android:padding="9dp">

            <FrameLayout
                android:id="@+id/attackTrayPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/dice_tray_attack" />

                <com.example.helloworld.DiceTrayView
                    android:id="@+id/attackDiceTray"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/gesture_attack_desc" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/defenceTrayPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/dice_tray_defence" />

                <com.example.helloworld.DiceTrayView
                    android:id="@+id/defenceDiceTray"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/gesture_defence_desc" />

                <TextView
                    android:id="@+id/coverRetainedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_panel_inset"
                    android:drawableStart="@drawable/ic_defence"
                    android:drawablePadding="5dp"
                    android:drawableTint="@color/normal_success"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="7dp"
                    android:text="@string/cover_retained_badge"
                    android:textColor="@color/normal_success"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/gestureCoach"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_panel_inset"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="@string/gesture_coach"
                android:textColor="@color/primary_light"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/gestureHintText"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="50dp"
                android:background="@drawable/bg_panel_inset"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/gesture_idle"
                android:textColor="@color/text_steel"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/summaryLayout"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_gravity="bottom"
                android:layout_margin="8dp"
                android:background="@drawable/bg_result_strip"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="invisible">

                <TextView
                    android:id="@+id/normalCountText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/normal_success"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/criticalCountText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/critical_result"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/failureCountText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/failure_result"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/consolePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/bg_control_panel_new"
            android:orientation="vertical"
            android:padding="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/diceControlCell" style="@style/CompactControlCell" android:layout_marginEnd="3dp">
                    <TextView android:id="@+id/diceCountLabel" style="@style/CompactControlLabel" android:text="@string/attack_dice_label" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
                        <TextView android:id="@+id/btnDiceMinus" style="@style/CompactStepButton" android:contentDescription="@string/decrease_dice" android:text="−" />
                        <TextView android:id="@+id/diceCountText" style="@style/CompactValueText" android:text="5" />
                        <TextView android:id="@+id/btnDicePlus" style="@style/CompactStepButton" android:contentDescription="@string/increase_dice" android:text="+" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/thresholdControlCell" style="@style/CompactControlCell" android:layout_marginStart="3dp">
                    <TextView android:id="@+id/thresholdLabel" style="@style/CompactControlLabel" android:text="@string/hit_label" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
                        <TextView android:id="@+id/btnThresholdMinus" style="@style/CompactStepButton" android:contentDescription="@string/decrease_threshold" android:text="▼" />
                        <TextView android:id="@+id/thresholdText" style="@style/CompactValueText" android:text="3+" />
                        <TextView android:id="@+id/btnThresholdPlus" style="@style/CompactStepButton" android:contentDescription="@string/increase_threshold" android:text="▲" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/criticalText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control_cell"
                    android:drawableTop="@drawable/ic_critical"
                    android:drawablePadding="1dp"
                    android:drawableTint="@color/critical_result"
                    android:gravity="center"
                    android:text="@string/critical_six"
                    android:textColor="@color/critical_result"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRoll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1.25"
                    android:background="@drawable/sel_roll_green"
                    android:drawableTop="@drawable/ic_dice"
                    android:drawablePadding="0dp"
                    android:drawableTint="@color/text_primary"
                    android:fontFamily="@font/teko_variable"
                    android:gravity="center"
                    android:text="@string/roll_button"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/postRollButtons"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnReroll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="2"
                    android:alpha="0.55"
                    android:background="@drawable/bg_button_metal"
                    android:drawableTop="@drawable/ic_reroll"
                    android:drawablePadding="1dp"
                    android:drawableTint="@color/primary_light"
                    android:enabled="false"
                    android:gravity="center"
                    android:text="@string/select_dice_to_reroll"
                    android:textColor="@color/primary_light"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_metal"
                    android:drawableTop="@drawable/ic_clear"
                    android:drawablePadding="1dp"
                    android:drawableTint="@color/text_steel"
                    android:enabled="false"
                    android:gravity="center"
                    android:text="@string/clear_button"
                    android:textColor="@color/text_steel"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/historyEdgeHandle"
        android:layout_width="14dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@android:color/transparent" />

    <LinearLayout
        android:id="@+id/historyPanel"
        android:layout_width="match_parent"
        android:layout_height="480dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_control_panel_new"
        android:elevation="18dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout android:id="@+id/historyHeader" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/history_title" android:textColor="@color/primary_light" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/btnCloseHistory" android:layout_width="72dp" android:layout_height="38dp" android:background="@drawable/bg_button_metal" android:drawableTop="@drawable/ic_close" android:drawablePadding="1dp" android:drawableTint="@color/text_primary" android:gravity="center" android:includeFontPadding="false" android:text="@string/history_close" android:textColor="@color/text_primary" />
        </LinearLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:id="@+id/historyList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/btnClearHistory"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_button_metal"
            android:drawableTop="@drawable/ic_clear"
            android:drawablePadding="2dp"
            android:drawableTint="@color/failure_result"
            android:gravity="center"
            android:text="@string/history_clear"
            android:textColor="@color/failure_result"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
