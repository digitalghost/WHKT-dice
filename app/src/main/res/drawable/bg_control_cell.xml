<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <gradient android:angle="270" android:startColor="#302816" android:endColor="#17120B" />
            <stroke android:width="1dp" android:color="#D3A640" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <gradient android:angle="270" android:startColor="#24211C" android:endColor="#0C0B09" />
            <stroke android:width="1dp" android:color="#51442C" />
        </shape>
    </item>
</selector>
