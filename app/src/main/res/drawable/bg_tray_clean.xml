<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#1D1D1D" android:endColor="#101010" android:angle="270" />
            <stroke android:width="1dp" android:color="#353535" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:gravity="top|left" android:width="32dp" android:height="2dp">
        <shape><solid android:color="#C54C21" /></shape>
    </item>
    <item android:gravity="bottom|right" android:width="32dp" android:height="2dp">
        <shape><solid android:color="#C54C21" /></shape>
    </item>
</layer-list>
