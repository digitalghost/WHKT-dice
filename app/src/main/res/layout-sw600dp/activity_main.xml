<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_console_screen">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_header_console"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnRulesHelp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_metal"
                    android:contentDescription="@string/rules_help_toggle_desc"
                    android:padding="0dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_rules"
                    android:tint="@color/primary_light" />

                <ImageButton
                    android:id="@+id/btnHistory"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_metal"
                    android:contentDescription="@string/history_button_desc"
                    android:padding="0dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_history"
                    android:tint="@color/primary_light" />

                <ImageButton
                    android:id="@+id/btnDiceTheme"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_metal"
                    android:contentDescription="@string/dice_theme_button_desc"
                    android:padding="0dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_skin"
                    android:tint="@color/primary_light" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/teko_variable"
                    android:letterSpacing="0.16"
                    android:text="@string/console_title"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/header_winged_skull" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/statusLamp"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/lamp_dim" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:fontFamily="monospace"
                    android:text="@string/status_loading"
                    android:textColor="@color/success_light"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp">

            <FrameLayout
                android:id="@+id/diceStage"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dice_stage"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/attackTrayPage"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:scaleType="fitCenter"
                                android:src="@drawable/dice_tray_attack" />

                            <com.example.helloworld.DiceTrayView
                                android:id="@+id/attackDiceTray"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/gesture_attack_desc" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/summaryLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="12dp"
                            android:alpha="0.97"
                            android:background="@drawable/bg_result_overlay"
                            android:elevation="12dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:visibility="invisible">

                            <TextView
                                style="@style/TabletResultModeText"
                                android:text="@string/mode_attack" />

                            <View style="@style/TabletResultDivider" />

                            <TextView android:id="@+id/normalCountText" style="@style/TabletResultText" android:textColor="@color/normal_success" />
                            <TextView android:id="@+id/criticalCountText" style="@style/TabletResultText" android:textColor="@color/critical_result" />
                            <TextView android:id="@+id/failureCountText" style="@style/TabletResultText" android:textColor="@color/failure_result" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/defenceTrayPage"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:scaleType="fitCenter"
                                android:src="@drawable/dice_tray_defence" />

                            <com.example.helloworld.DiceTrayView
                                android:id="@+id/defenceDiceTray"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/gesture_defence_desc" />

                            <TextView
                                android:id="@+id/coverRetainedBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:layout_margin="10dp"
                                android:background="@drawable/bg_panel_inset"
                                android:drawableStart="@drawable/ic_defence"
                                android:drawablePadding="5dp"
                                android:drawableTint="@color/normal_success"
                                android:gravity="center"
                                android:padding="8dp"
                                android:text="@string/cover_retained_badge"
                                android:textColor="@color/normal_success"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/defenceSummaryLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="12dp"
                            android:alpha="0.97"
                            android:background="@drawable/bg_result_overlay"
                            android:elevation="12dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:visibility="invisible">

                            <TextView
                                style="@style/TabletResultModeText"
                                android:text="@string/mode_defence" />

                            <View style="@style/TabletResultDivider" />

                            <TextView android:id="@+id/defenceNormalCountText" style="@style/TabletResultText" android:textColor="@color/normal_success" />
                            <TextView android:id="@+id/defenceCriticalCountText" style="@style/TabletResultText" android:textColor="@color/critical_result" />
                            <TextView android:id="@+id/defenceFailureCountText" style="@style/TabletResultText" android:textColor="@color/failure_result" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/gestureCoach"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_panel_inset"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="9dp"
                    android:text="@string/gesture_coach_tablet"
                    android:textColor="@color/primary_light"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/gestureHintText"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="66dp"
                    android:background="@drawable/bg_panel_inset"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/gesture_idle_tablet"
                    android:textColor="@color/text_steel"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/resolutionPanel"
                    android:layout_width="wrap_content"
                    android:layout_height="58dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="18dp"
                    android:alpha="0.98"
                    android:background="@drawable/bg_resolution_overlay"
                    android:elevation="16dp"
                    android:gravity="center_vertical"
                    android:minWidth="420dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:drawableStart="@drawable/ic_critical"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/primary_light"
                        android:gravity="center_vertical"
                        android:text="@string/resolution_title"
                        android:textColor="@color/primary_light"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:background="@color/border_gold_strong" />

                    <TextView
                        android:id="@+id/resolutionText"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:textColor="@color/critical_result"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                android:id="@+id/consolePanel"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_control_panel_new"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="7dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1.6"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/diceControlCell" style="@style/CompactControlCell" android:layout_marginEnd="3dp">
                        <TextView android:id="@+id/diceCountLabel" style="@style/CompactControlLabel" android:text="@string/attack_dice_label" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
                            <TextView android:id="@+id/btnDiceMinus" style="@style/CompactStepButton" android:contentDescription="@string/decrease_dice" android:text="−" />
                            <TextView android:id="@+id/diceCountText" style="@style/CompactValueText" android:text="5" />
                            <TextView android:id="@+id/btnDicePlus" style="@style/CompactStepButton" android:contentDescription="@string/increase_dice" android:text="+" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/thresholdControlCell" style="@style/CompactControlCell" android:layout_marginStart="3dp">
                        <TextView android:id="@+id/thresholdLabel" style="@style/CompactControlLabel" android:text="@string/hit_label" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
                            <TextView android:id="@+id/btnThresholdMinus" style="@style/CompactStepButton" android:contentDescription="@string/decrease_threshold" android:text="▼" />
                            <TextView android:id="@+id/thresholdText" style="@style/CompactValueText" android:text="3+" />
                            <TextView android:id="@+id/btnThresholdPlus" style="@style/CompactStepButton" android:contentDescription="@string/increase_threshold" android:text="▲" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/criticalText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="0.72"
                    android:background="@drawable/bg_control_cell"
                    android:drawableTop="@drawable/ic_critical"
                    android:drawablePadding="0dp"
                    android:drawableTint="@color/critical_result"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/critical_six"
                    android:textColor="@color/critical_result"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnRoll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="0.9"
                    android:background="@drawable/sel_roll_green"
                    android:drawableTint="@color/text_primary"
                    android:fontFamily="@font/teko_variable"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/roll_button"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/postRollButtons"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btnReroll"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="2"
                        android:alpha="0.55"
                        android:background="@drawable/bg_button_metal"
                        android:drawableTop="@drawable/ic_reroll"
                        android:drawablePadding="1dp"
                        android:drawableTint="@color/primary_light"
                        android:enabled="false"
                        android:gravity="center"
                        android:text="@string/select_dice_to_reroll"
                        android:textColor="@color/primary_light"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnReset"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_metal"
                        android:drawableTop="@drawable/ic_clear"
                        android:drawablePadding="1dp"
                        android:drawableTint="@color/text_steel"
                        android:enabled="false"
                        android:gravity="center"
                        android:text="@string/clear_button"
                        android:textColor="@color/text_steel"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/rulesHelpOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6000000"
        android:clickable="true"
        android:elevation="20dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/rulesHelpPanel"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="12dp"
            android:layout_marginTop="60dp"
            android:background="@drawable/bg_control_panel_new"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="@string/rules_help_title"
                    android:textColor="@color/primary_light"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCloseRulesHelp"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_button_metal"
                    android:contentDescription="@string/rules_help_close_desc"
                    android:gravity="center"
                    android:text="@string/rules_help_close"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/rulesHelpContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel_inset"
                android:fadeScrollbars="false"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:maxHeight="420dp"
                android:paddingStart="12dp"
                android:paddingTop="9dp"
                android:paddingEnd="12dp"
                android:paddingBottom="9dp"
                android:scrollbars="vertical"
                android:textColor="@color/text_steel"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:gravity="center_vertical|end"
                android:text="@string/rules_help_order_hint"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/historyEdgeHandle"
        android:layout_width="18dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@android:color/transparent" />

    <LinearLayout
        android:id="@+id/historyPanel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_control_panel_new"
        android:elevation="20dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout android:id="@+id/historyHeader" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/history_title" android:textColor="@color/primary_light" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/btnCloseHistory" android:layout_width="72dp" android:layout_height="40dp" android:background="@drawable/bg_button_metal" android:drawableTop="@drawable/ic_close" android:drawablePadding="1dp" android:drawableTint="@color/text_primary" android:gravity="center" android:includeFontPadding="false" android:text="@string/history_close" android:textColor="@color/text_primary" />
        </LinearLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:id="@+id/historyList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/btnClearHistory"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_button_metal"
            android:drawableTop="@drawable/ic_clear"
            android:drawablePadding="2dp"
            android:drawableTint="@color/failure_result"
            android:gravity="center"
            android:text="@string/history_clear"
            android:textColor="@color/failure_result"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
