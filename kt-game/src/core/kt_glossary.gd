class_name KTGlossary
extends RefCounted

## Rule glossary: keyword -> { name, kind, team, short, full, icon }.
## Loaded once from data/core/glossary.json (generated by tools/build_glossary.py).
## `lookup()` tolerates numeric suffixes ("穿刺 1", "致命 5+", "范围 8\"") and keeps the number
## so the short text can substitute it for "x".

static var _entries: Dictionary = {}
static var _loaded: bool = false
static var _kw_re: RegEx = null

const KIND_LABEL := {
	"weapon": "武器规则", "status": "状态", "faction": "阵营规则", "ability": "特工能力",
	"ploy": "计谋", "tactic": "战团战术", "equipment": "阵营装备",
}


static func _ensure_loaded() -> void:
	if _loaded:
		return
	_loaded = true
	var path := "res://data/core/glossary.json"
	if not FileAccess.file_exists(path):
		push_warning("KTGlossary: %s missing, run tools/build_glossary.py" % path)
		return
	var txt := FileAccess.get_file_as_string(path)
	var parsed = JSON.parse_string(txt)
	if typeof(parsed) != TYPE_DICTIONARY:
		return
	for e in parsed.get("entries", []):
		_entries[str(e["name"])] = e


## Split "致命 5+" -> ["致命", "5+"]; "关键穿刺 1" -> ["关键穿刺", "1"]; "范围 8\"" -> ["范围", "8\""].
static func split_keyword(raw: String) -> PackedStringArray:
	var s := raw.strip_edges()
	if _kw_re == null:
		_kw_re = RegEx.new()
		_kw_re.compile("^([^\\d（(]+?)\\s*([\\d][\\d+\"\\.]*)?\\s*(?:[（(].*?[)）])?\\s*$")
	var m := _kw_re.search(s)
	if m == null:
		return PackedStringArray([s, ""])
	return PackedStringArray([m.get_string(1).strip_edges(), m.get_string(2).strip_edges()])


static func lookup(raw: String) -> Dictionary:
	_ensure_loaded()
	var parts := split_keyword(raw)
	var base := parts[0]
	var num := parts[1]
	var e: Dictionary = _entries.get(base, {})
	if e.is_empty():
		# try alias without 【】 and trailing punctuation
		base = base.replace("【", "").replace("】", "")
		e = _entries.get(base, {})
	if e.is_empty():
		return {}
	var out := e.duplicate()
	out["display"] = raw.strip_edges()
	out["value"] = num
	if not num.is_empty():
		out["short"] = str(out["short"]).replace("x\"", num if num.ends_with("\"") else num + "\"").replace("x+", num).replace("x", num.trim_suffix("+").trim_suffix("\""))
	return out


static func has(raw: String) -> bool:
	return not lookup(raw).is_empty()


## Find glossary keywords inside free text (e.g. a mod_tag "神射手: 精准+1 & 严重").
## Returns entries in order of appearance, deduplicated.
static func find_in_text(txt: String) -> Array[Dictionary]:
	_ensure_loaded()
	var found: Array[Dictionary] = []
	var seen := {}
	var hits: Array = []
	for name in _entries.keys():
		var idx := txt.find(str(name))
		if idx >= 0:
			hits.append([idx, str(name)])
	hits.sort_custom(func(a, b): return int(a[0]) < int(b[0]))
	for h in hits:
		var n := str(h[1])
		# prefer the longest name at the same position (e.g. 关键穿刺 over 穿刺)
		var overlapped := false
		for s in seen.keys():
			if n != s and str(s).contains(n):
				overlapped = true
		if overlapped or seen.has(n):
			continue
		seen[n] = true
		found.append(_entries[n].duplicate())
	return found


static func all_entries() -> Array:
	_ensure_loaded()
	return _entries.values()
