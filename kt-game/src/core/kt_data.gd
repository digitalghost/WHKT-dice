static var _teams_cache: Dictionary = {}
static var _texture_cache: Dictionary = {}


static func get_team(team_id: String) -> Dictionary:
	if _teams_cache.has(team_id):
		return _teams_cache[team_id]
	var path := "res://data/teams/%s.json" % team_id
	if not FileAccess.file_exists(path):
		push_error("Missing synced team JSON: " + path)
		return {}
	var raw := FileAccess.get_file_as_string(path)
	var parsed = JSON.parse_string(raw)
	if typeof(parsed) == TYPE_DICTIONARY:
		_teams_cache[team_id] = parsed
		return parsed
	return {}


static func load_tex(res_path: String) -> Texture2D:
	if res_path.is_empty():
		return null
	if _texture_cache.has(res_path):
		return _texture_cache[res_path]
	if ResourceLoader.exists(res_path):
		var tex := load(res_path) as Texture2D
		if tex != null:
			_texture_cache[res_path] = tex
			return tex
	# Fallback direct Image load for runtime-synced PNGs before editor import
	var global_path := ProjectSettings.globalize_path(res_path)
	if FileAccess.file_exists(global_path):
		var img := Image.load_from_file(global_path)
		if img != null and not img.is_empty():
			var itex := ImageTexture.create_from_image(img)
			_texture_cache[res_path] = itex
			return itex
	return null


static func get_ploys(team_id: String, category: String) -> Array[Dictionary]:
	var team := get_team(team_id)
	var out: Array[Dictionary] = []
	for entry in team.get("rule_entries", []):
		if str(entry.get("category", "")) == category:
			out.append(entry)
	return out


## Default killzone: official Approved Ops 2025 map 4 (data/maps/volkus_25_04.json, generated by
## tools/build_volkus_map.py from the terrain meshes). Falls back to the hand-built layout when the
## JSON is missing so a bare checkout still runs.
const DEFAULT_MAP_ID := "volkus_25_04"
const MAP_IDS: Array[String] = ["volkus_25_01", "volkus_25_02", "volkus_25_03", "volkus_25_04", "volkus_25_05", "volkus_25_06"]
static var _map_cache: Dictionary = {}


## 开局界面按钮上显示的短名，例如 "地图 1"
static func map_short_label(map_id: String) -> String:
	if not MAP_IDS.has(map_id):
		return map_id
	var num: int = int(map_id.right(2))
	return "地图 %d" % num


## 一句话说明，地图 1-3 返回 "降落区：东/西两侧短边 6\" 纵深"，地图 4-6 返回 "降落区：南/北两侧长边 3\" 纵深"
static func map_deploy_hint(map_id: String) -> String:
	if not MAP_IDS.has(map_id):
		return ""
	var num: int = int(map_id.right(2))
	if num >= 1 and num <= 3:
		return "降落区：东/西两侧短边 6\" 纵深"
	if num >= 4 and num <= 6:
		return "降落区：南/北两侧长边 3\" 纵深"
	return ""


static func load_map(map_id: String) -> Dictionary:
	if _map_cache.has(map_id):
		return _map_cache[map_id].duplicate(true)
	var path := "res://data/maps/%s.json" % map_id
	if not FileAccess.file_exists(path):
		push_warning("KTData.load_map: %s missing, using built-in layout" % path)
		return create_volkus_killzone()
	var parsed = JSON.parse_string(FileAccess.get_file_as_string(path))
	if typeof(parsed) != TYPE_DICTIONARY:
		return create_volkus_killzone()
	var m: Dictionary = parsed
	# JSON arrays -> engine types (Rect2 / Vector2) exactly as create_volkus_killzone() provides them
	var r_a: Array = m["drop_zone_a"]
	var r_b: Array = m["drop_zone_b"]
	m["drop_zone_a"] = Rect2(r_a[0], r_a[1], r_a[2], r_a[3])
	m["drop_zone_b"] = Rect2(r_b[0], r_b[1], r_b[2], r_b[3])
	for o in m["objectives"]:
		var p: Array = o["pos"]
		o["pos"] = Vector2(p[0], p[1])
	for t in m["terrains"]:
		var r: Array = t["rect"]
		t["rect"] = Rect2(r[0], r[1], r[2], r[3])
	for key in ["spawn_a", "spawn_b"]:
		var out: Array = []
		for p in m.get(key, []):
			out.append(Vector2(p[0], p[1]))
		m[key] = out
	for v in m.get("visuals", []):
		var pv: Array = v["pos_in"]
		v["pos_in"] = Vector2(pv[0], pv[1])
	_map_cache[map_id] = m
	return m.duplicate(true)


